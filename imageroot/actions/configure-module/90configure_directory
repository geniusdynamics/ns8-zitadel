import json
import sys

from zitadel_directory import APIError, reconcile, selected

request = json.load(sys.stdin)
if "ldap_domain" in request or "ldap_additional_domains" in request:
    try:
        reconcile(request["host"].lower(), selected(request))
    except APIError as error:
        sys.exit(str(error))
