#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
import json
import sys

import agent
from zitadel_directory import CREDENTIAL, MAPPING, read, selected

request = json.load(sys.stdin)
names = selected(request)
active = any(item.get("active") for item in read(MAPPING).get("organizations", {}).values())
if ("ldap_domain" in request or "ldap_additional_domains" in request) and (names or active):
    credentials = read(CREDENTIAL)
    if credentials.get("host") != request["host"].lower() or not credentials.get("token"):
        agent.set_status("validation-failed")
        json.dump([{"field": "ldap_domain", "parameter": "ldap_domain", "value": "",
                    "error": "ldap_token_required"}], sys.stdout)
        sys.exit(3)
